pragma circom 2.1.0;

// Poseidon2 permutation, BN254 scalar field, state width t = 3, S-box x^5.
//
// Parameters are the *published* BN254 ("bn256") instance from the Poseidon2
// reference implementation: Grassi, Khovratovich, Schofnegger, "Poseidon2: A
// Faster Version of the Poseidon Hash Function" (https://eprint.iacr.org/2023/323),
// reference code https://github.com/HorizenLabs/poseidon2,
// `plain_implementations/src/poseidon2/poseidon2_instance_bn256.rs`
// (`POSEIDON2_BN256_PARAMS`, t=3, d=5, RF=8, RP=56). Nothing here is
// self-derived: round constants, and the external/internal linear-layer
// matrices below, are transcribed byte-for-byte from that file and validated
// against its own `kats` test vector before being used in any circuit — see
// `docs/research/2026-09-19-poseidon2-merkle-swap.md` for the validation
// script and its output.
//
// Round structure (RF/2 full rounds, RP partial rounds, RF/2 full rounds):
//   external linear layer (free — additions only, no multiplication)
//   for r in 0..4:   x += RC[r]; x = x^5 (all 3 lanes); external linear layer
//   for r in 4..60:  x[0] += RC[r][0]; x[0] = x[0]^5;    internal linear layer
//   for r in 60..64: x += RC[r]; x = x^5 (all 3 lanes); external linear layer
//
// The external layer for t=3 is the fixed matrix circ(2,1,1); the internal
// layer is diag(1,1,2) + J (all-ones). Both are folded directly into each
// output signal's linear combination via a compile-time `var` accumulator
// (matching circomlib's own Mix/MixLast style) so the running sum never
// becomes a separate constrained signal — the same pattern circomlib uses
// to keep a full linear layer down to one R1CS row per output element.
//
// Used as a 2-to-1 compression function via Poseidon2Hash2to1 below, matching
// the reference implementation's own `MerkleTreeHash::compress` convention:
// permutation([a, b, 0])[0] — capacity element fixed at index 2, output read
// from index 0. This is a drop-in replacement for circomlib's `Poseidon(2)`
// (which internally also runs a width-3 permutation, RF=8/RP=57, over a
// dense random MDS matrix) at the same call sites: Merkle-path hashing
// (`templates/merkle_proof.circom`) and `withdraw.circom`'s recipient-hash.
//
// Poseidon2 output is NOT the same value as circomlib Poseidon output for the
// same inputs — different round constants and linear layers. The two hash
// families are not interchangeable at the same call site within one proof;
// see the soundness section of the report above for what that implies for a
// production swap.

template Poseidon2Sbox() {
    signal input in;
    signal output out;
    signal in2;
    signal in4;
    in2 <== in * in;
    in4 <== in2 * in2;
    out <== in4 * in;
}

template Poseidon2Perm3() {
    signal input in[3];
    signal output out[3];

    var RF = 8;
    var RP = 56;
    var half = 4;

    var RC[64][3] = [
        [13128406282895484157369354038809433636203389051939936481821261911791933663254, 18931653859213243425446645781588512487838213266321401679594943842133071369744, 14100663835952519432830313936592734340076294692040144715814219945570907513297],
        [4829113795940962171577509772302063766582957624337039572002553144762883322341, 15524196826242151316602020382811195434692947787822797536837043495207890599720, 11824742889827005569732308046012743315382715056680481843559537371456931944245],
        [15824369292130948538570881538463827283727388637222356799784648390667783881850, 7395652367440825515524159918310823124942438011035473842936180620057265532493, 1241351203963627868835881804826107927839874261162687401459390240620885410254],
        [6688265362431458560657026053775250595854204120757399493099812773970419156132, 18628865421786169197184064906533816626840829027307965436801990532221681661310, 17770079997659052348824924629777474963416629061770380464722096481670103655806],
        [11811415718957691261673974625780511541635150909919309658375768251762566747317, 0, 0],
        [17491388639298611159333770975992024026420968324544834879936543171716736973879, 0, 0],
        [5647537972700463414111873015737673282707440513292923385601908870282442800104, 0, 0],
        [13098696909140066209556423100763036393001603197583133354863092304798723388565, 0, 0],
        [6951180250619279643770888203380891623788978362131976553140006882493632020745, 0, 0],
        [11250251081997661635793843737498879309304455145146915350538637298238893102958, 0, 0],
        [2246982048814095620312232487641427155108104073024754628893054837638848127964, 0, 0],
        [18897180842973857564376958241871700087418903006311506731527228148081597475814, 0, 0],
        [11557404599711559103972421944754928847181400366333080241838467983028485750549, 0, 0],
        [17156358787639157774388183034849932704703797218604790661321342987075785318260, 0, 0],
        [8846001957151556825394442611430138293780354129800063716225175548340091032449, 0, 0],
        [21883449834630454155761926448978525628607016008113566399646971468161186616967, 0, 0],
        [11782201180140779170005707786217005381305915516114251118577530420880166417952, 0, 0],
        [19574374768428302416384468550351257389078501920039012797497943057156188490399, 0, 0],
        [8515987927591912252146893631936027853249294776314628553087138119917968203620, 0, 0],
        [17278996890957540943430295799612663512184925495827057764219426280563743078943, 0, 0],
        [4560144125266860756441160513270281593457202308593722614013851111005532208589, 0, 0],
        [18507459160700813704135500972073304101922968342745790738233104310822653821881, 0, 0],
        [12853272419783978245995917302225694649366687506910892647236063701566570840428, 0, 0],
        [14374895923592519298500369713759001634990764548024903321294831249025876110484, 0, 0],
        [1754533789272381217541450481312878927560073411620344950409407505576538004136, 0, 0],
        [20448232810715691360468548645921483318770769828465347895613479253435247065293, 0, 0],
        [4203277692183102377396835282861288449527228200284576966986741905195109677387, 0, 0],
        [11506339386261725202512749094297334054772084639665212079028551409689271965431, 0, 0],
        [4408799661846477128378547528471700197737434561274043409442231147309460168718, 0, 0],
        [10862521404448958117187164110262290189825635328197001646848012017699995213390, 0, 0],
        [7012061838863338817532836723152059636816924388921632356281537445328382279260, 0, 0],
        [8337544039076735620694225144163354013921209405711398618659178986151546625400, 0, 0],
        [16173744372216956516796750206695252671549928142051779144629150462255079400849, 0, 0],
        [19072902632067672883974143637757649536845413107085656789672471396027868707732, 0, 0],
        [3487852254355424154670010750480228751987308757772575371606146474985412561707, 0, 0],
        [17727517395793273304860106667199855253218123164763798377815886217088561516989, 0, 0],
        [13280131383170382695839570176732265848909891244754629477752800360224963964534, 0, 0],
        [21504421972374418324171209120165696620934505501591484695447432472073975792776, 0, 0],
        [13753604424945682926871108642602624411461374991709441590662260371815673344981, 0, 0],
        [8053178768600673579416591772204841415225213226540397062676127402210384682315, 0, 0],
        [15101558583452488762759591936595783545455044970328380152280373697190919758012, 0, 0],
        [6286700389345423344101403023711121482167900236544298155098199100234816571786, 0, 0],
        [19368755554193272721035317233504719593365546521121074341670771231332472422552, 0, 0],
        [13306281365497267243785678269212920842854030794417306689235276460198094483575, 0, 0],
        [10121764749051640353641114693266514664967620368543293902008953934189850195966, 0, 0],
        [179619165022370308972665071682395477322215797039585945216341070107573537790, 0, 0],
        [14053393851645634065914179337120715807963438235922115988819572738574714471437, 0, 0],
        [17345906218970918797922168310670548252023720338285437740234091480846393436478, 0, 0],
        [10383068492552043678323859571562933490503408853170063884414176092784243607055, 0, 0],
        [12096041499044892166554391619429604246288825927654072010011878199637889490527, 0, 0],
        [6449742640166027959651492823149770763572943879017164812917305794918053034585, 0, 0],
        [6551805454148805882554763665748573416514894105513920161214733482541847062214, 0, 0],
        [3651410956659878392469489270906333016569562868954890104332567650040497030813, 0, 0],
        [15219053914464753937310253926447830297339787956721755285255510737973021838676, 0, 0],
        [881679665678132972106931291023348167890022611850562267871389203532691753422, 0, 0],
        [5006067481688857073852527145736822635357747460125905556158034280392250104971, 0, 0],
        [12765332320844032254009314500332101047115754896003948733635815046365410860591, 0, 0],
        [12908190215073542091623737558383307555705501651914623082354191483197810853182, 0, 0],
        [1446042792715825508366007519346636771782990303010685652946852324744810237839, 0, 0],
        [17414863822034645298427260856470503848317996477890518738401812766215195632841, 0, 0],
        [12123026335854515584932892161148559902027319284544852339906677442670161590992, 11747143856113197599032240626240804787576886917202313931914972592787570603429, 12689083329367969619896630238881490862330991685178863399139986099061967775891],
        [9363616378570856727297258914956380343356030981401312041884116403700849212733, 13238291046435061349401827110993774315432323243867917623501520885175217584478, 13857006478672530359037215101120381968370236111775805219419707798416454682620],
        [2022752961549084842139747691238383165524359342011064407942599644003308437489, 11377043765620686524844863869245961003946340433252666374730228559486855986878, 9107028336454933966239128359918274121166034584181733998485105905495346200934],
        [900063247840342897532382686223939136593244983486268682637380837456165317070, 11261302954518146885624063833699323298803404236535464228351677636819579513431, 7126990412157463341897179572979760225771626877677162088926546182321369054630]
    ];

    signal state[65][3];

    // initial external linear layer, no RC/sbox before it
    var sum0 = in[0] + in[1] + in[2];
    state[0][0] <== in[0] + sum0;
    state[0][1] <== in[1] + sum0;
    state[0][2] <== in[2] + sum0;

    component sboxF[8][3];
    component sboxP[56];

    var rcIdx = 0;

    // first RF/2 full rounds: state[0..half] -> state[half]
    for (var i = 0; i < half; i++) {
        sboxF[i][0] = Poseidon2Sbox();
        sboxF[i][0].in <== state[i][0] + RC[rcIdx][0];
        sboxF[i][1] = Poseidon2Sbox();
        sboxF[i][1].in <== state[i][1] + RC[rcIdx][1];
        sboxF[i][2] = Poseidon2Sbox();
        sboxF[i][2].in <== state[i][2] + RC[rcIdx][2];

        var fsum = sboxF[i][0].out + sboxF[i][1].out + sboxF[i][2].out;
        state[i + 1][0] <== sboxF[i][0].out + fsum;
        state[i + 1][1] <== sboxF[i][1].out + fsum;
        state[i + 1][2] <== sboxF[i][2].out + fsum;

        rcIdx++;
    }

    // RP partial rounds: state[half..half+RP] -> state[half+RP]
    for (var i = 0; i < RP; i++) {
        var si = half + i;
        sboxP[i] = Poseidon2Sbox();
        sboxP[i].in <== state[si][0] + RC[rcIdx][0];

        var psum = sboxP[i].out + state[si][1] + state[si][2];
        state[si + 1][0] <== sboxP[i].out + psum;
        state[si + 1][1] <== state[si][1] + psum;
        state[si + 1][2] <== 2 * state[si][2] + psum;

        rcIdx++;
    }

    // last RF/2 full rounds: state[half+RP..half+RP+half] -> state[64]
    for (var i = 0; i < half; i++) {
        var si = half + RP + i;
        sboxF[half + i][0] = Poseidon2Sbox();
        sboxF[half + i][0].in <== state[si][0] + RC[rcIdx][0];
        sboxF[half + i][1] = Poseidon2Sbox();
        sboxF[half + i][1].in <== state[si][1] + RC[rcIdx][1];
        sboxF[half + i][2] = Poseidon2Sbox();
        sboxF[half + i][2].in <== state[si][2] + RC[rcIdx][2];

        var fsum2 = sboxF[half + i][0].out + sboxF[half + i][1].out + sboxF[half + i][2].out;
        state[si + 1][0] <== sboxF[half + i][0].out + fsum2;
        state[si + 1][1] <== sboxF[half + i][1].out + fsum2;
        state[si + 1][2] <== sboxF[half + i][2].out + fsum2;

        rcIdx++;
    }

    out[0] <== state[64][0];
    out[1] <== state[64][1];
    out[2] <== state[64][2];
}

// 2-to-1 compression: permutation([a, b, 0])[0] — matches the reference
// implementation's MerkleTreeHash::compress convention exactly.
template Poseidon2Hash2to1() {
    signal input in[2];
    signal output out;

    component perm = Poseidon2Perm3();
    perm.in[0] <== in[0];
    perm.in[1] <== in[1];
    perm.in[2] <== 0;

    out <== perm.out[0];
}
