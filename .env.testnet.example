# Veil Testnet Configuration
# Copy to .env.testnet and fill in deployment values

NEXT_PUBLIC_PACKAGE_ID=<your-package-id>
NEXT_PUBLIC_POOL_ID=<your-pool-id>
NEXT_PUBLIC_COMPLIANCE_CONFIG_ID=<your-compliance-config-id>
NEXT_PUBLIC_ADMIN_CAP_ID=<your-admin-cap-id>
NEXT_PUBLIC_TREASURY_CAP_ID=<your-treasury-cap-id>
NEXT_PUBLIC_UPGRADE_CAP_ID=<your-upgrade-cap-id>
NEXT_PUBLIC_DEPLOYER_ADDRESS=<your-deployer-address>
NEXT_PUBLIC_EPOCH_DURATION_MS=3600000
NEXT_PUBLIC_SUI_NETWORK=testnet
